[Unit]
Description=Athan Prayer Times Daemon
Documentation=https://github.com/athan-app/athan-app
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/athan-daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Environment
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

# Resource limits
MemoryMax=100M
CPUQuota=10%

[Install]
WantedBy=default.target
